# Copiar a .env.local y ajustar. No lleva secretos: todo lo que empieza con NEXT_PUBLIC_ llega al navegador.

# API de Laravel (con /api al final). En desarrollo, "/api" pasa a la API por el proxy de Next
# (API_PROXY_TARGET, por defecto http://127.0.0.1:8000): así viaja la cookie HttpOnly de la sesión.
NEXT_PUBLIC_API_URL=/api

# Página pública (landing) y sistema. En local, el sistema se abre en app.localhost.
SITE_URL=http://localhost:3000
APP_URL=http://app.localhost:3000
