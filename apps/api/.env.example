APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# El rol Administrador siempre entra con verificación en dos pasos; false la deja a la casilla de cada usuario.
ADMIN_MFA_REQUIRED=true

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# La app debe conectarse como erp_app (respeta RLS). Usa erp_user solo para migrar.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=erp_saas
DB_USERNAME=erp_app
DB_PASSWORD=erp_app_password

# Minutos que dura una sesión iniciada (token de la API). 480 = 8 horas;
# con "Recordarme" marcado en el login, 43200 = 30 días.
SANCTUM_TOKEN_EXPIRATION=480
SANCTUM_REMEMBER_EXPIRATION=43200

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Con "log" los correos (código de verificación, recuperación de contraseña) no se
# envían: quedan en storage/logs/laravel.log. Para enviarlos de verdad usa smtp y
# completa host, puerto, usuario y contraseña del proveedor de correo.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Adjuntos: local = disco del servidor (storage/app/private/documents); s3 = MinIO o S3 (AWS_*).
DOCUMENTS_DRIVER=s3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
